---
import BaseLayout from '../layouts/BaseLayout.astro';
import { db, Link } from 'astro:db'

const links = await db.select().from(Link).execute();
---

<BaseLayout>
	<header class="h-12 bg-gray-700 text-gray-100 text-2xl font-bold flex items-center">
		<h1>Your Links</h1>
	</header>
	<section class="grid grid-cols-3 gap-4 max-w-[900px] mx-auto p-4">
		{links.map((link) => (
			<article class="min-w-40 min-h-25 border-1 border-gray-300 border-solid p-4 rounded-md bg-white">
				<h2>{link.title}</h2>
				<p>{link.url}</p>
			</article>
		))}
	</section>
</BaseLayout>
